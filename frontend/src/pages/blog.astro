---
import BaseLayout from "../layouts/BaseLayout.astro";
import { BlogPosts } from "../components/blog";
import { getPosts } from "../lib/posts";

// Metadata only. Post content is fetched lazily by the modal on open
// (see src/pages/blog/[slug].json.ts).
const posts = getPosts();
---

<BaseLayout title="Blog" currentPage="blog">
  <header>
    <h1>Blog</h1>
    <p class="text-muted">Notes on development, tooling, and experiments.</p>
    {
      posts.some((p) => p.agentWritten) && (
        <p class="text-muted blog-note">
          Some posts are written by an AI agent (opencode) on behalf of
          cheonglol — his words appear in quotes.
        </p>
      )
    }
  </header>

  <div class="section-divider"><span class="dot"></span></div>

  <section>
    <h2>Posts</h2>
    <BlogPosts posts={posts} client:load />
  </section>
</BaseLayout>

<style lang="scss">
  @use "../styles/tokens" as *;

  header {
    margin-bottom: $space-2;
  }
</style>
