---
import "../styles/main.scss";

interface NavChild {
  href: string;
  label: string;
}

interface NavItem {
  href: string;
  label: string;
  page: string;
  /** Optional subroutes. Renders as a hover/tap dropdown under the item. */
  children?: NavChild[];
}

interface Props {
  title?: string;
  currentPage?: string;
}

const { title = "cheonglol", currentPage = "profile" } = Astro.props;
const base = import.meta.env.BASE_URL;

const navItems: NavItem[] = [
  { href: `${base}`, label: "Profile", page: "profile" },
  { href: `${base}/blog`, label: "Blog", page: "blog" },
  // Subpath example — add `children` to any item to give it a dropdown:
  // {
  //   href: `${base}/blog`, label: "Blog", page: "blog",
  //   children: [
  //     { href: `${base}/blog/tag/ai`, label: "AI" },
  //     { href: `${base}/blog/tag/backend`, label: "Backend" },
  //   ],
  // },
];
const showNav = navItems.length > 1;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next:ital,wght@0,200..800;1,200..800&family=Gentium+Book+Plus:ital,wght@0,400;0,700;1,400;1,700&family=Cascadia+Code:wght@200..700&display=swap"
      rel="stylesheet"
    />
    <link rel="describedby" type="text/plain" href={`${base}/llms.txt`} />
    <title>{title}</title>
  </head>
  <body class:list={{ "has-nav": showNav }}>
    {showNav && (
      <nav class="top-nav" id="top-nav" aria-label="Main navigation">
        {navItems.map((item) => (
          <div
            class:list={[
              "nav-item",
              { "has-children": !!item.children, active: currentPage === item.page },
            ]}
          >
            <a href={item.href} aria-haspopup={item.children ? "true" : undefined}>
              {item.label}
            </a>
            {item.children && (
              <div class="nav-dropdown">
                {item.children.map((child) => (
                  <a href={child.href}>{child.label}</a>
                ))}
              </div>
            )}
          </div>
        ))}
      </nav>
    )}
    <main class="container">
      <slot />
    </main>
    <button id="tilt-enable" class="tilt-enable" type="button" hidden>Enable tilt</button>
    <script>
      // Touch devices: first tap on a parent opens its dropdown instead of navigating.
      const touch = window.matchMedia("(hover: none)").matches;
      document.querySelectorAll(".nav-item.has-children > a").forEach((link) => {
        link.addEventListener("click", (e) => {
          if (!touch) return; // hover handles it on desktop
          const item = link.parentElement;
          const isOpen = item.classList.contains("open");
          document.querySelectorAll(".nav-item.open").forEach((o) => {
            if (o !== item) o.classList.remove("open");
          });
          if (!isOpen) e.preventDefault();
          item.classList.toggle("open", !isOpen);
        });
      });

      // Close dropdowns on outside click or Escape.
      document.addEventListener("click", (e) => {
        if (!e.target.closest(".nav-item")) {
          document.querySelectorAll(".nav-item.open").forEach((o) => o.classList.remove("open"));
        }
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          document.querySelectorAll(".nav-item.open").forEach((o) => o.classList.remove("open"));
        }
      });
    </script>
    <script>
      import { initTilt, enableTilt } from "../scripts/tilt";

      // Tilt is off by default. Offer the button unless the effect is already
      // running (remembered from a past visit) or reduced motion forbids it.
      const running = initTilt();
      const tiltBtn = document.getElementById("tilt-enable") as HTMLButtonElement | null;
      const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (tiltBtn && !running && !reduced) {
        tiltBtn.hidden = false;
        tiltBtn.addEventListener("click", async () => {
          if (await enableTilt()) tiltBtn.hidden = true;
          else tiltBtn.textContent = "Tilt unavailable";
        });
      }
    </script>
  </body>
</html>
