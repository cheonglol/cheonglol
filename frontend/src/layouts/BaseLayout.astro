---
import "../styles/global.scss";
import { siteConfig } from "../config/site";

interface NavItem {
  href: string;
  label: string;
  page: string;
}

interface Props {
  title?: string;
  currentPage?: string;
}

const { title = "cheonglol", currentPage = "profile" } = Astro.props;
const base = import.meta.env.BASE_URL;

const navItems: NavItem[] = [
  { href: `${base}`, label: "Profile", page: "profile" },
];
if (siteConfig.showBlog) {
  navItems.push({ href: `${base}/blog`, label: "Blog", page: "blog" });
}
if (siteConfig.showDocs) {
  navItems.push({ href: `${base}/docs`, label: "Docs", page: "docs" });
}
const showNav = navItems.length > 1;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class:list={{ "has-nav": showNav }}>
    {showNav && (
      <nav class="top-nav" id="top-nav" aria-label="Main navigation">
        <select class="nav-select" id="nav-select" aria-label="Navigate to page">
          {navItems.map((item) => (
            <option
              value={item.href}
              selected={currentPage === item.page}
            >
              {item.label}
            </option>
          ))}
        </select>
      </nav>
    )}
    <main class="container">
      <slot />
    </main>
    <script>
      const select = document.getElementById("nav-select");
      if (select) {
        select.addEventListener("change", () => {
          if (select.value) {
            window.location.href = select.value;
          }
        });
      }
    </script>
  </body>
</html>
