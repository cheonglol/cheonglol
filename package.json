{
  "name": "cheonglol",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "bootstrap": "bun install",
    "dev": "bun --cwd frontend dev",
    "generate:resume": "bun run scripts/generate-resume.ts",
    "test": "bun test tests/",
    "build": "bun run generate:resume && bun run test && bun --cwd frontend build",
    "preview": "bun --cwd frontend preview",
    "smoke": "bun --cwd frontend build && test -d frontend/dist"
  },
  "files": [
    "frontend"
  ],
  "packageManager": "bun@1.3.9",
  "dependencies": {
    "@types/pdfkit": "^0.17.6",
    "pdfkit": "^0.19.1"
  }
}
